{
  "openapi": "3.1.0",
  "info": {
    "title": "케미체크119 공개 합성 지령 Replay 계약",
    "version": "1.1.0",
    "description": "실제 119 연계를 사칭하지 않고 Incident Intake 경계를 검증하는 staging/demo 전용 SSE 계약입니다."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/c2guard/v1/intake/replay-stream/{scenarioId}": {
      "get": {
        "operationId": "streamPublicSyntheticIncident",
        "summary": "공개 합성 지령 1건을 SSE로 전달",
        "description": "환경에서 명시적으로 활성화된 경우에만 동작하며, 운영 장애 시 자동 fallback으로 호출하지 않습니다.",
        "parameters": [
          {
            "name": "scenarioId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "CONTEST-LIVE-CHEMICAL-001"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE event name은 incident.accepted이며 data는 IncidentEnvelope입니다.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "public replay flag가 없고 세션도 없는 경우"
          },
          "404": {
            "description": "replay 비활성화 또는 등록되지 않은 scenario"
          }
        },
        "security": [],
        "x-public-only-when-configured": true,
        "x-production-default-enabled": false,
        "x-implementation-owner": "BE_Repository",
        "x-official-119-integration": false
      }
    },
    "/api/c2guard/v1/intake/replays/{incidentId}/confirmations/{role}": {
      "post": {
        "operationId": "confirmPublicSyntheticReplaySubstance",
        "summary": "서버 고정 공개 합성 물질을 시연용으로 확인",
        "description": "요청 본문을 받지 않습니다. 현재 BE가 발급하고 TTL 안에 보관 중인 PUBLIC_SYNTHETIC incidentId에만 역할별 고정 CAS를 기록합니다.",
        "parameters": [
          {
            "name": "incidentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
            }
          },
          {
            "name": "role",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "INCIDENT",
                "FACILITY"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "멱등 저장된 공개 합성 확인. INCIDENT는 7681-52-9, FACILITY는 7647-01-0으로 고정됩니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyntheticReplayConfirmation"
                }
              }
            }
          },
          "401": {
            "description": "public synthetic confirmation flag가 없고 세션도 없는 경우"
          },
          "404": {
            "description": "기능 비활성화 또는 현재 인스턴스가 발급하지 않은 incidentId"
          },
          "410": {
            "description": "합성 incidentId의 TTL 만료"
          }
        },
        "security": [],
        "x-public-only-when-configured": true,
        "x-production-default-enabled": false,
        "x-request-body-allowed": false,
        "x-caller-selected-cas-allowed": false,
        "x-implementation-owner": "BE_Repository",
        "x-official-field-confirmation": false
      }
    }
  },
  "components": {
    "schemas": {
      "IncidentLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "IncidentDatasetReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "usage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "usage": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "SyntheticReplayConfirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "requestId",
          "incidentId",
          "confirmationId",
          "role",
          "casNumber",
          "displayName",
          "dataClassification",
          "confirmationType",
          "createdAt",
          "confirmedCount",
          "allRequiredConfirmed",
          "reanalyzeRequired",
          "disclosure"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "chemicheck119-synthetic-replay-confirmation-v1"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "incidentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "confirmationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "INCIDENT",
              "FACILITY"
            ]
          },
          "casNumber": {
            "type": "string",
            "enum": [
              "7681-52-9",
              "7647-01-0"
            ]
          },
          "displayName": {
            "type": "string",
            "enum": [
              "차아염소산나트륨",
              "염산"
            ]
          },
          "dataClassification": {
            "type": "string",
            "const": "PUBLIC_SYNTHETIC"
          },
          "confirmationType": {
            "type": "string",
            "const": "SYNTHETIC_DEMO_CONFIRMATION"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "allRequiredConfirmed": {
            "type": "boolean"
          },
          "reanalyzeRequired": {
            "type": "boolean",
            "const": true
          },
          "disclosure": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "IncidentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "incidentId",
          "sourceEventId",
          "idempotencyKey",
          "receivedAt",
          "occurredAt",
          "stationId",
          "stationDisplayName",
          "facilityName",
          "addressText",
          "location",
          "reportText",
          "sourceType",
          "dataClassification",
          "sourceProvider",
          "sourceSchemaVersion",
          "requestId",
          "containsPersonalInformation",
          "disclosure",
          "datasetReferences"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "chemicheck119-incident-envelope-v1"
          },
          "incidentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceEventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "stationDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "facilityName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "addressText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "location": {
            "$ref": "#/components/schemas/IncidentLocation"
          },
          "reportText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sourceType": {
            "type": "string",
            "const": "SYNTHETIC_DISPATCH_REPLAY"
          },
          "dataClassification": {
            "type": "string",
            "const": "PUBLIC_SYNTHETIC"
          },
          "sourceProvider": {
            "type": "string",
            "const": "CHEMICHECK119_PUBLIC_REPLAY"
          },
          "sourceSchemaVersion": {
            "type": "string",
            "const": "public-replay-v1"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "containsPersonalInformation": {
            "type": "boolean",
            "const": false
          },
          "disclosure": {
            "type": "string",
            "minLength": 1
          },
          "datasetReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/IncidentDatasetReference"
            }
          }
        }
      }
    }
  },
  "x-contract-version": "chemicheck119-incident-intake-replay-v1",
  "x-data-boundary": "PUBLIC_SYNTHETIC_ONLY",
  "x-live-processing-path": "FE_TO_BE_TO_AI",
  "x-authorized-dispatch-status": "NOT_CONNECTED"
}
