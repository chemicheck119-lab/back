{
  "openapi": "3.1.0",
  "info": {
    "title": "케미체크119 공개 합성 지령 Replay 계약",
    "version": "1.0.0",
    "description": "실제 119 연계를 사칭하지 않고 Incident Intake 경계를 검증하는 staging/demo 전용 SSE 계약입니다."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/c2guard/v1/intake/replay-stream/{scenarioId}": {
      "get": {
        "operationId": "streamPublicSyntheticIncident",
        "summary": "공개 합성 지령 1건을 SSE로 전달",
        "description": "환경에서 명시적으로 활성화된 경우에만 동작하며, 운영 장애 시 자동 fallback으로 호출하지 않습니다.",
        "parameters": [
          {
            "name": "scenarioId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "CONTEST-LIVE-CHEMICAL-001"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE event name은 incident.accepted이며 data는 IncidentEnvelope입니다.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "public replay flag가 없고 세션도 없는 경우"
          },
          "404": {
            "description": "replay 비활성화 또는 등록되지 않은 scenario"
          }
        },
        "security": [],
        "x-public-only-when-configured": true,
        "x-production-default-enabled": false,
        "x-implementation-owner": "BE_Repository",
        "x-official-119-integration": false
      }
    }
  },
  "components": {
    "schemas": {
      "IncidentLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "IncidentDatasetReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "usage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "usage": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "IncidentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "incidentId",
          "sourceEventId",
          "idempotencyKey",
          "receivedAt",
          "occurredAt",
          "stationId",
          "stationDisplayName",
          "facilityName",
          "addressText",
          "location",
          "reportText",
          "sourceType",
          "dataClassification",
          "sourceProvider",
          "sourceSchemaVersion",
          "requestId",
          "containsPersonalInformation",
          "disclosure",
          "datasetReferences"
        ],
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "chemicheck119-incident-envelope-v1"
          },
          "incidentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceEventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "stationDisplayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "facilityName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "addressText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "location": {
            "$ref": "#/components/schemas/IncidentLocation"
          },
          "reportText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "sourceType": {
            "type": "string",
            "const": "SYNTHETIC_DISPATCH_REPLAY"
          },
          "dataClassification": {
            "type": "string",
            "const": "PUBLIC_SYNTHETIC"
          },
          "sourceProvider": {
            "type": "string",
            "const": "CHEMICHECK119_PUBLIC_REPLAY"
          },
          "sourceSchemaVersion": {
            "type": "string",
            "const": "public-replay-v1"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "containsPersonalInformation": {
            "type": "boolean",
            "const": false
          },
          "disclosure": {
            "type": "string",
            "minLength": 1
          },
          "datasetReferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/IncidentDatasetReference"
            }
          }
        }
      }
    }
  },
  "x-contract-version": "chemicheck119-incident-intake-replay-v1",
  "x-data-boundary": "PUBLIC_SYNTHETIC_ONLY",
  "x-live-processing-path": "FE_TO_BE_TO_AI",
  "x-authorized-dispatch-status": "NOT_CONNECTED"
}
